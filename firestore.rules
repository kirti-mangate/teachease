rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Global Safety Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. User Profiles & Student Metadata
    function isAdmin() {
      // For now, only allows the specific user as admin if they exist in an admins collection
      // or just simplify if not really needed. The instructions mention a bootstrapped admin.
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'department', 'subject']);
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid 
             && data.name is string && data.name.size() <= 100
             && data.email is string && data.email.size() <= 100
             && data.role in ['teacher', 'student'];
    }

    match /students/{studentId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == studentId || isAdmin()) && isValidStudent(request.resource.data);
    }

    function isValidStudent(data) {
      return data.uid is string 
             && data.name is string 
             && data.enrollmentNumber is string;
    }

    // 2. Attendance Records (Modified for Student/Teacher separation)
    match /attendance/{attendanceId} {
      allow list: if isSignedIn() && (resource.data.teacherId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow get: if isSignedIn() && (resource.data.teacherId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && isValidAttendance(request.resource.data);
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    function isValidAttendance(data) {
      return data.teacherId == request.auth.uid
             && data.studentName is string && data.studentName.size() <= 100
             && data.status in ['present', 'absent']
             && data.date is string && data.date.size() <= 20;
    }

    // 3. AI Generated Content
    match /assignments/{id} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidContent(request.resource.data);
    }
    
    match /notes/{id} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidContent(request.resource.data);
    }
    
    match /ppt_content/{id} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidContent(request.resource.data);
    }

    function isValidContent(data) {
      return data.teacherId == request.auth.uid
             && data.topic is string && data.topic.size() <= 500
             && data.content is string && data.content.size() <= 100000;
    }
  }
}
